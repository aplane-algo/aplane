/keys/
/cache/
.apshell_history
.apadmin_history
*.key
*.key.json
*.pub
config.json
config.yaml

# Auto-generated plugin imports (generated by Makefile)
cmd/apshell/plugin_*.go
!cmd/apshell/plugin_args.go

# Core plugin symlinks (coreplugins_repository/ contains the actual code)
coreplugins/*
!coreplugins/README.md

# Untracked external plugins
examples/external_plugins/folksgo/
examples/external_plugins/echo-plugin/echo-plugin
examples/external_plugins/reti/reti
examples/external_plugins/reti/.sea/
plugins/algokit-localnet/algokit-localnet

# Local settings
settings.local.json
.claude/
.mcp.json
.githooks/
# System configuration (Pi setup, services, etc.)
etc/

# Node modules (for plugins)
node_modules/
package-lock.json
!sdk/typescript/aplane/package-lock.json
!examples/external_plugins/reti/package-lock.json

# Plugin checksums (generated by plugin-checksum)
checksums.sha256

# Temporary files
*.tmp
*.log
*.bak
.codex
internal/docassets/generated/

# Signing keys (secret key must never be committed)
minisign.key
!minisign.pub

# Test environment (contains secrets)
.env.test
test-mnemonic.sh

# Test cache artifacts
internal/cache/cache/
internal/engine/cache/
internal/jsapi/cache/
test/integration/cache/
docs/formal/states/

# Build output
bin/*
!bin/.gitkeep
dist/
!examples/external_plugins/reti/dist/
!examples/external_plugins/reti/dist/**

# MCP server binaries
mcp/aplane-mcp
mcp/refresh-accounts
