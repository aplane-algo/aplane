# Auto-unlocked apsigner configuration
# See docs/USER_CONFIG.md for full documentation.

# Config schema version. Omit means v1 for existing configs.
schema_version: 1

# INSECURE / DEV ONLY: Auto-unlock by reading passphrase from a file via appass-file helper.
# Set argv[0] to the absolute path of your installed appass-file helper.
# In production, use a secrets manager (macOS Keychain, TPM, Vault, etc.)
# See docs/USER_CONFIG.md for secure examples.
passphrase_command_argv: ["/usr/local/bin/appass-file", "passphrase"]

# Signer endpoint exposure settings.
endpoint:
  # Optional client-reachable URL used by "apadmin endpoint export" when --host/--url are omitted.
  # Set this to a real DNS name or IP clients can reach.
  # advertise_url: ssh://signer.example.com:1127
  signer_port: 11270
  ssh:
    listen_address: 127.0.0.1
    port: 1127
    host_key_path: .ssh/ssh_host_key
    authorized_keys_path: .ssh/authorized_keys

# IPC socket for admin interface (apadmin, apapprover)
# Uses default: $APSIGNER_DATA/aplane.sock

# Inactivity timeout before auto-lock: "0" = never, "15m" = 15 minutes, "1h" = 1 hour
passphrase_timeout: "0"

# Enable user auto-approve for non-rejected default-fallback signing requests
user_auto_approve: true

# Lock signer when apadmin disconnects
lock_on_disconnect: false

# Network settings (used for algod access, TEAL compilation, policy enforcement, etc.)
networks:
  testnet:
    algod:
      server: https://testnet-api.4160.nodely.dev
      token: ""
  mainnet:
    algod:
      server: https://mainnet-api.4160.nodely.dev
      token: ""
  localnet:
    algod:
      server: http://localhost:4001
      token: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    # genesis_hash: "base64-or-hex-32-byte-localnet-genesis-hash"

# Network whose algod is used for TEAL compilation (default: testnet)
teal_compile_network: testnet

# Security settings
require_memory_protection: false
