# apshell configuration
# Copy to $APCLIENT_DATA/config.yaml and customize as needed.
# See docs/USER_CONFIG.md for full documentation.

# Algorand network context token (mainnet, testnet, betanet, localnet, etc.)
network: testnet

# Restrict which networks can be used. Add localnet here if you run AlgoKit LocalNet.
networks_allowed:
  - mainnet
  - testnet

# Signer REST API port (local port for tunnel)
signer_port: 11270

# Background /status polling interval for keyset refresh ("0" disables)
signer_status_poll_interval: "10s"

# SSH tunnel settings (required — use localhost for same-machine signer)
ssh:
  host: localhost            # Change to remote host if signer is on another machine
  port: 1127
  identity_file: .ssh/id_ed25519      # Relative to $APCLIENT_DATA
  known_hosts_path: .ssh/known_hosts  # Relative to $APCLIENT_DATA

# Color theme: auto (detect terminal), dark, or light
# theme: auto

# Network settings (Nodely public endpoints and AlgoKit LocalNet)
networks:
  testnet:
    algod:
      server: https://testnet-api.4160.nodely.dev
      token: ""
  mainnet:
    algod:
      server: https://mainnet-api.4160.nodely.dev
      token: ""
  localnet:
    algod:
      server: http://localhost:4001
      token: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  # betanet:
  #   algod:
  #     server: https://betanet-api.4160.nodely.dev
  #     token: ""
