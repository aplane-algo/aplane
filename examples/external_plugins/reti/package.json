{
  "name": "reti-plugin",
  "version": "1.0.0",
  "description": "Reti staking plugin for APlane Shell",
  "type": "module",
  "main": "dist/reti-plugin.js",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "22.22.0"
  },
  "scripts": {
    "build": "npm run build:js && npm run build:standalone",
