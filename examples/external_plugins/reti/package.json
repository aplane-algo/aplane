  "dependencies": {
    "@algorandfoundation/algokit-utils": "9.2.0",
    "algosdk": "3.5.2"
  },
  "devDependencies": {
    "@types/node": "20.19.39",
    "esbuild": "0.28.0",
    "postject": "1.0.0-alpha.6",
    "typescript": "5.9.3"
  }
}
