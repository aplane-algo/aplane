{
  "name": "reti-plugin",
  "version": "1.0.0",
  "description": "Reti staking pool plugin",
  "author": "APlane Shell Team",
  "homepage": "https://github.com/algorandfoundation/reti",
  "executable": "./reti",
  "args": [],
  "commands": [
    {
      "name": "reti",
      "description": "Interact with Reti staking pools",
      "usage": "reti list [count] | validator <id> | pools <id> | deposit <amt> algo into <validator> for <addr> | withdraw <amt|all> algo from app <pool_app_id> for <addr> | withdraw <amt|all> algo from validator <validator_id> pool <pool_id> for <addr> | balance <addr> | claim <addr>",
      "examples": [
        "reti list",
        "reti list 10",
        "reti validator 123",
        "reti pools 123",
        "reti deposit 1000 algo into 123 for alice",
        "reti withdraw 500 algo from app 456 for alice",
        "reti withdraw all algo from app 456 for alice",
        "reti withdraw all algo from validator 1 pool 1 for alice",
        "reti balance alice",
        "reti claim alice"
      ],
      "category": "defi",
      "arg_specs": [
        {
          "type": "keyword",
          "values": ["list", "validator", "pools", "deposit", "withdraw", "balance", "claim"]
        },
        {
          "branches": [
            {
              "when": {"arg": 0, "matches": "^validator$"},
              "specs": [
                {"type": "custom", "values": ["validator_id"]}
              ]
            },
            {
              "when": {"arg": 0, "matches": "^pools$"},
              "specs": [
                {"type": "custom", "values": ["validator_id"]}
              ]
            },
            {
              "when": {"arg": 0, "matches": "^deposit$"},
              "specs": [
                {"type": "number"},
                {"type": "keyword", "values": ["algo"]},
                {"type": "keyword", "values": ["into"]},
                {"type": "custom", "values": ["validator_id"]},
                {"type": "keyword", "values": ["for"]},
                {"type": "address"}
              ]
            },
            {
              "when": {"arg": 0, "matches": "^withdraw$"},
              "specs": [
                {"type": "custom", "values": ["amount_or_all"]},
                {"type": "keyword", "values": ["algo"]},
                {"type": "keyword", "values": ["from"]},
                {"type": "keyword", "values": ["app", "validator"]},
                {"type": "custom", "values": ["withdraw_target"]},
                {"type": "keyword", "values": ["for", "pool"]},
                {"type": "custom", "values": ["withdraw_target"]},
                {"type": "keyword", "values": ["for"]},
                {"type": "address"}
              ]
            },
            {
              "when": {"arg": 0, "matches": "^(balance|claim)$"},
              "specs": [
                {"type": "address"}
              ]
            }
          ]
        }
      ]
    }
  ],
  "networks": ["testnet", "mainnet", "betanet", "fnet", "localnet", "sandbox"],
  "timeout": 120,
  "manifest_format": "2.0"
}
