{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aplane:policy:v1",
  "title": "APlane policy document v1",
  "description": "One policy document: a node's default policy (key \"default\") or one key's own policy (policies/<key>.json), for the node role named by \"role\". The document is the signer/cosigner boundary: whatever produces it, the node validates, signs, and enforces only what this schema and the node's semantic checks accept. Every verdict-bearing field is required; nothing is inherited. Amounts are decimal strings in base units (microAlgos or ASA base units).",
  "oneOf": [
    {
      "$ref": "#/$defs/signerPolicy"
    },
    {
      "$ref": "#/$defs/cosignerPolicy"
    }
  ],
  "$defs": {
    "signerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "role",
        "key",
        "reject_close_remainder",
        "reject_asset_close",
        "reject_clawback",
        "max_fee_microalgos",
        "transaction_types",
        "transfer_policy",
        "reject_foreign_rekey",
        "always_review_warnings",
        "auto_approve_self_noop_transfer"
      ],
      "properties": {
        "format": {
          "const": "aplane.policy.v1"
        },
        "role": {
          "const": "signer"
        },
        "key": {
          "anyOf": [
            {
              "const": "default"
            },
            {
              "$ref": "#/$defs/address"
            }
          ],
          "description": "\"default\" for the node default, or the Algorand address of the key this document governs. Must equal the file name."
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "reject_foreign_rekey": {
          "type": "boolean",
          "description": "Reject a non-zero RekeyTo whose target this signer does not hold."
        },
        "reject_close_remainder": {
          "type": "boolean",
          "description": "Reject ALGO close-outs."
        },
        "reject_asset_close": {
          "type": "boolean",
          "description": "Reject ASA close-outs."
        },
        "reject_clawback": {
          "type": "boolean",
          "description": "Reject ASA clawbacks."
        },
        "always_review_warnings": {
          "type": "boolean",
          "description": "Send transactions with warning findings to operator review."
        },
        "auto_approve_self_noop_transfer": {
          "type": "boolean",
          "description": "Auto-approve a tightly constrained self no-op transfer."
        },
        "max_fee_microalgos": {
          "$ref": "#/$defs/amount",
          "description": "Reject a higher transaction fee; \"0\" is no cap."
        },
        "transaction_types": {
          "$ref": "#/$defs/signerTransactionTypes"
        },
        "limits": {
          "$ref": "#/$defs/signerLimits"
        },
        "address_sets": {
          "$ref": "#/$defs/addressSets"
        },
        "asset_sets": {
          "$ref": "#/$defs/assetSets"
        },
        "transfer_policy": {
          "$ref": "#/$defs/signerTransferPolicy"
        }
      }
    },
    "cosignerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "role",
        "key",
        "reject_close_remainder",
        "reject_asset_close",
        "reject_clawback",
        "max_fee_microalgos",
        "transaction_types",
        "transfer_policy",
        "reject_rekey"
      ],
      "properties": {
        "format": {
          "const": "aplane.policy.v1"
        },
        "role": {
          "const": "cosigner"
        },
        "key": {
          "anyOf": [
            {
              "const": "default"
            },
            {
              "$ref": "#/$defs/witnessKeyID"
            }
          ],
          "description": "\"default\" for the node default, or the Witness Key ID this document governs. Must equal the file name."
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "reject_close_remainder": {
          "type": "boolean"
        },
        "reject_asset_close": {
          "type": "boolean"
        },
        "reject_clawback": {
          "type": "boolean"
        },
        "reject_rekey": {
          "type": "boolean",
          "description": "Reject every non-zero RekeyTo. When false, rekey_policy decides."
        },
        "max_fee_microalgos": {
          "$ref": "#/$defs/amount",
          "description": "Reject a higher transaction fee; \"0\" is no cap. A cosigner has no warning review, so a finite cap is advised whenever routes permit movements."
        },
        "transaction_types": {
          "$ref": "#/$defs/cosignerTransactionTypes"
        },
        "limits": {
          "$ref": "#/$defs/cosignerLimits"
        },
        "address_sets": {
          "$ref": "#/$defs/addressSets"
        },
        "asset_sets": {
          "$ref": "#/$defs/assetSets"
        },
        "transfer_policy": {
          "$ref": "#/$defs/cosignerTransferPolicy"
        },
        "rekey_policy": {
          "$ref": "#/$defs/rekeyPolicy"
        }
      }
    },
    "typeVerdict": {
      "enum": [
        "allow",
        "review",
        "reject"
      ]
    },
    "signerTransactionTypes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "*"
      ],
      "description": "Per-type verdict: allow continues through every other phase, review is Always Review, reject is Always Deny. \"*\" covers every type not named and is required.",
      "properties": {
        "*": {
          "$ref": "#/$defs/typeVerdict"
        },
        "pay": {
          "$ref": "#/$defs/typeVerdict"
        },
        "axfer": {
          "$ref": "#/$defs/typeVerdict"
        },
        "acfg": {
          "$ref": "#/$defs/typeVerdict"
        },
        "afrz": {
          "$ref": "#/$defs/typeVerdict"
        },
        "keyreg": {
          "$ref": "#/$defs/typeVerdict"
        },
        "appl": {
          "$ref": "#/$defs/typeVerdict"
        },
        "stpf": {
          "$ref": "#/$defs/typeVerdict"
        },
        "hb": {
          "$ref": "#/$defs/typeVerdict"
        }
      }
    },
    "cosignerTransactionTypes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "*"
      ],
      "description": "Per-type verdict. A cosigner has no operator: every value is allow or reject, and only pay and axfer, the types routing governs, may be allowed.",
      "properties": {
        "*": {
          "const": "reject"
        },
        "pay": {
          "enum": [
            "allow",
            "reject"
          ]
        },
        "axfer": {
          "enum": [
            "allow",
            "reject"
          ]
        },
        "acfg": {
          "const": "reject"
        },
        "afrz": {
          "const": "reject"
        },
        "keyreg": {
          "const": "reject"
        },
        "appl": {
          "const": "reject"
        },
        "stpf": {
          "const": "reject"
        },
        "hb": {
          "const": "reject"
        }
      }
    },
    "signerTransferPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on_no_route",
        "close_on_no_route",
        "clawback_on_no_route",
        "routes"
      ],
      "properties": {
        "on_no_route": {
          "$ref": "#/$defs/routeMissAction",
          "description": "Verdict for a movement that matches no route."
        },
        "close_on_no_route": {
          "$ref": "#/$defs/routeMissAction",
          "description": "Verdict for a close-out no route allows."
        },
        "clawback_on_no_route": {
          "$ref": "#/$defs/routeMissAction",
          "description": "Verdict for a clawback no route allows."
        },
        "blocked_destinations": {
          "$ref": "#/$defs/blockedDestinations"
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signerRoute"
          }
        }
      }
    },
    "signerRoute": {
      "allOf": [
        {
          "$ref": "#/$defs/routeShape"
        }
      ],
      "properties": {
        "limits": {
          "$ref": "#/$defs/signerLimits"
        }
      },
      "unevaluatedProperties": false
    },
    "signerLimits": {
      "type": "object",
      "description": "Per-network, per-asset amount thresholds in base units.",
      "propertyNames": {
        "$ref": "#/$defs/network"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "$ref": "#/$defs/assetRef"
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "reject_above": {
              "$ref": "#/$defs/amount"
            },
            "review_above": {
              "$ref": "#/$defs/amount"
            }
          }
        }
      }
    },
    "cosignerTransferPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "routes"
      ],
      "description": "The cosigner allow-list. Any movement no route allows is rejected; there are no review outcomes.",
      "properties": {
        "blocked_destinations": {
          "$ref": "#/$defs/blockedDestinations"
        },
        "routes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cosignerRoute"
          }
        }
      }
    },
    "cosignerRoute": {
      "allOf": [
        {
          "$ref": "#/$defs/routeShape"
        }
      ],
      "properties": {
        "limits": {
          "$ref": "#/$defs/cosignerLimits"
        }
      },
      "unevaluatedProperties": false
    },
    "cosignerLimits": {
      "type": "object",
      "description": "Per-network, per-asset amount thresholds in base units. Cosigner policy cannot produce review verdicts.",
      "propertyNames": {
        "$ref": "#/$defs/network"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "$ref": "#/$defs/assetRef"
        },
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "reject_above": {
              "$ref": "#/$defs/amount"
            }
          },
          "required": [
            "reject_above"
          ]
        }
      }
    },
    "rekeyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed"
      ],
      "description": "Authorizes pure 0-ALGO self-payment rekeys whose sender and target match an allowed edge.",
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sender",
              "targets"
            ],
            "properties": {
              "sender": {
                "$ref": "#/$defs/addressOrSet"
              },
              "targets": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/addressOrSet"
                }
              }
            }
          }
        }
      }
    },
    "routeShape": {
      "type": "object",
      "required": [
        "id",
        "networks",
        "sources",
        "assets",
        "destinations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "maxLength": 64
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "networks": {
          "oneOf": [
            {
              "type": "array",
              "const": [
                "*"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/network"
              }
            }
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/addressTerm"
          }
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assetTerm"
          }
        },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/destinationTerm"
          }
        },
        "allow_close": {
          "type": "boolean",
          "description": "Allow close-outs to this route's destinations. Not allowed with wildcard destinations."
        },
        "allow_clawback": {
          "type": "boolean",
          "description": "Allow clawbacks; requires asset_sources."
        },
        "asset_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/addressTerm"
          },
          "description": "Accounts assets may be clawed back from; only with allow_clawback."
        }
      }
    },
    "addressSets": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/setName"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/address"
            }
          },
          {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "$ref": "#/$defs/network"
            },
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/address"
              }
            }
          }
        ]
      }
    },
    "assetSets": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/setName"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "$ref": "#/$defs/network"
        },
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/assetRef"
          }
        }
      }
    },
    "blockedDestinations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/address"
      },
      "uniqueItems": true
    },
    "routeMissAction": {
      "enum": [
        "reject",
        "review",
        "operator_default"
      ]
    },
    "addressTerm": {
      "anyOf": [
        {
          "$ref": "#/$defs/address"
        },
        {
          "$ref": "#/$defs/setRef"
        },
        {
          "const": "*"
        }
      ]
    },
    "destinationTerm": {
      "anyOf": [
        {
          "$ref": "#/$defs/addressTerm"
        },
        {
          "const": "self"
        }
      ]
    },
    "addressOrSet": {
      "anyOf": [
        {
          "$ref": "#/$defs/address"
        },
        {
          "$ref": "#/$defs/setRef"
        }
      ]
    },
    "assetTerm": {
      "anyOf": [
        {
          "$ref": "#/$defs/assetRef"
        },
        {
          "$ref": "#/$defs/setRef"
        },
        {
          "const": "*"
        }
      ]
    },
    "assetRef": {
      "type": "string",
      "pattern": "^(?:algo|asa:(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615))$",
      "description": "\"algo\" or \"asa:<id>\" with an ASA ID from 1 through 18446744073709551615 (uint64)."
    },
    "setRef": {
      "type": "string",
      "pattern": "^@[a-z0-9_-]+$"
    },
    "setName": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "maxLength": 64
    },
    "address": {
      "type": "string",
      "pattern": "^[A-Z2-7]{58}$"
    },
    "witnessKeyID": {
      "type": "string",
      "pattern": "^[A-Z2-7]{52}$"
    },
    "network": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "maxLength": 64
    },
    "amount": {
      "type": "string",
      "pattern": "^(?:0|(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615))$",
      "description": "Unsigned decimal in base units, 0 through 18446744073709551615 (uint64)."
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    }
  }
}
