## This file should be installed as:
##
##   /etc/systemd/system/apsigner.service
##
## and then running "systemctl daemon-reload".

[Unit]
Description=APlane Signer daemon (apsigner)
After=network.target
AssertPathExists=/var/lib/apsigner

[Service]
ExecStart=/usr/local/bin/apsigner
User=aplane
Group=aplane
Environment=APSIGNER_DATA=/var/lib/apsigner
Environment=APLANE_SYSTEMD_MANAGED=1
RuntimeDirectory=apsigner
RuntimeDirectoryMode=0750
Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
UMask=0077
CapabilityBoundingSet=CAP_IPC_LOCK
AmbientCapabilities=CAP_IPC_LOCK
LimitMEMLOCK=infinity
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
