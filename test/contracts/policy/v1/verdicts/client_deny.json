{
  "format": "aplane.policy-verdicts.v1",
  "description": "Always Deny on client signing: what is rejected, how violations are collected across positions, and a missing policy.",
  "cases": [
    {
      "name": "type reject",
      "surface": "sign",
      "policies": {
        "default": {
          "transaction_types": {
            "*": "allow",
            "pay": "reject"
          },
          "transfer_policy": {
            "on_no_route": "operator_default"
          }
        }
      },
      "group": [
        {
          "type": "pay",
          "sender": "A1",
          "receiver": "A2",
          "amount": 5
        }
      ],
      "expect": {
        "outcome": "reject",
        "kind": "forbidden",
        "message": "policy engine rejected request: txn 1: [transaction_type:pay] pay transactions are rejected by policy"
      }
    },
    {
      "name": "type reject keeps the same slot's routing violation",
      "surface": "sign",
      "policies": {
        "default": {
          "transaction_types": {
            "*": "allow",
            "pay": "reject"
          }
        }
      },
      "group": [
        {
          "type": "pay",
          "sender": "A1",
          "receiver": "A2",
          "amount": 5
        }
      ],
      "expect": {
        "outcome": "reject",
        "kind": "forbidden",
        "message": "policy engine rejected request: txn 1: [transaction_type:pay] pay transactions are rejected by policy; txn 1: [transfer_policy:route_miss] transfer routing found no route for pay movement"
      }
    },
    {
      "name": "route miss reject",
      "surface": "sign",
      "policies": {
        "default": {}
      },
      "group": [
        {
          "type": "pay",
          "sender": "A1",
          "receiver": "A2",
          "amount": 5
        }
      ],
      "expect": {
        "outcome": "reject",
        "kind": "forbidden",
        "message": "policy engine rejected request: txn 1: [transfer_policy:route_miss] transfer routing found no route for pay movement"
      }
    },
    {
      "name": "route reject_above",
      "surface": "sign",
      "policies": {
        "default": {
          "transfer_policy": {
            "routes": [
              {
                "id": "payroll",
                "networks": [
                  "testnet"
                ],
                "sources": [
                  "*"
                ],
                "assets": [
                  "algo"
                ],
                "destinations": [
                  "$A2"
                ],
                "limits": {
                  "testnet": {
                    "algo": {
                      "review_above": "10",
                      "reject_above": "20"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "group": [
        {
          "type": "pay",
          "sender": "A1",
          "receiver": "A2",
          "amount": 21
        }
      ],
      "expect": {
        "outcome": "reject",
        "kind": "forbidden",
        "message": "policy engine rejected request: txn 1: [transfer_policy:payroll:reject_above] transfer routing amount 21 exceeds reject threshold 20"
      }
    },
    {
      "name": "blocked destination wins over a matching route",
      "surface": "sign",
      "policies": {
        "default": {
          "transfer_policy": {
            "blocked_destinations": [
              "$A2"
            ],
            "routes": [
              {
                "id": "any",
                "networks": [
                  "*"
                ],
                "sources": [
                  "*"
                ],
                "assets": [
                  "*"
                ],
                "destinations": [
                  "*"
                ]
              }
            ]
          }
        }
      },
      "group": [
        {
          "type": "pay",
          "sender": "A1",
          "receiver": "A2",
          "amount": 1
        }
      ],
      "expect": {
        "outcome": "reject",
        "kind": "forbidden",
        "message": "policy engine rejected request: txn 1: [transfer_policy:blocked_destination] transfer routing rejected blocked destination AIAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAGFFWAF4 for pay movement"
      }
    },
    {
      "name": "close-out without allow_close",
      "surface": "sign",
      "policies": {
        "default": {
          "transfer_policy": {
            "routes": [
              {
                "id": "any",
                "networks": [
                  "*"
                ],
                "sources": [
                  "*"
                ],
                "assets": [
                  "*"
                ],
                "destinations": [
                  "*"
                ]
              }
            ]
          }
        }
      },
      "group": [
        {
          "type": "pay",
          "sender": "A1",
          "receiver": "A2",
          "amount": 1,
          "close_to": "A3"
        }
      ],
      "expect": {
        "outcome": "reject",
        "kind": "forbidden",
        "message": "policy engine rejected request: txn 1: [transfer_policy:any:close_rejected] transfer routing rejected pay_close movement without close.allow route"
      }
    },
    {
      "name": "unknown network under on_no_route reject",
      "surface": "sign",
      "policies": {
        "default": {
          "transfer_policy": {
            "routes": [
              {
                "id": "any",
                "networks": [
                  "*"
                ],
                "sources": [
                  "*"
                ],
                "assets": [
                  "*"
                ],
                "destinations": [
                  "*"
                ]
              }
            ]
          }
        }
      },
      "group": [
        {
          "type": "pay",
          "sender": "A1",
          "network": "unknown",
          "receiver": "A2",
          "amount": 1
