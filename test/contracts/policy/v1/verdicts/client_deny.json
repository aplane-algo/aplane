      "expect": {
        "outcome": "reject",
        "kind": "forbidden",
        "message": "policy engine rejected request: txn 1: [transfer_policy:unknown_genesis_hash] cannot evaluate transfer routing for unknown genesis hash"
      }
    },
    {
      "name": "foreign rekey rejected",
      "surface": "sign",
      "policies": {
        "default": {
          "transfer_policy": {
            "on_no_route": "operator_default"
          }
        }
      },
      "group": [
        {
          "type": "pay",
          "sender": "A1",
          "rekey_to": "A9",
          "receiver": "A1"
        }
      ],
      "expect": {
        "outcome": "reject",
        "kind": "forbidden",
        "message": "policy engine rejected request: txn 1: [reject_foreign_rekey] foreign rekey transactions are rejected by policy"
      }
    },
    {
      "name": "rekey to a held key is not foreign",
      "surface": "sign",
      "policies": {
        "default": {
          "transfer_policy": {
            "on_no_route": "operator_default"
          }
        }
      },
      "group": [
        {
          "type": "pay",
          "sender": "A1",
          "rekey_to": "A9",
          "receiver": "A1"
        }
      ],
      "known": [
        "A9"
      ],
      "expect": {
        "outcome": "default"
      }
    },
    {
      "name": "violations collected across slots in index order",
      "surface": "sign",
      "policies": {
        "default": {
          "transaction_types": {
            "*": "allow",
            "axfer": "reject"
          }
        }
      },
      "group": [
        {
          "type": "pay",
          "sender": "A1",
          "receiver": "A2",
          "amount": 1
        },
        {
          "type": "axfer",
          "sender": "A3",
          "asset": 7,
          "asset_receiver": "A4",
          "asset_amount": 1
        },
        {
          "type": "pay",
          "sender": "A5",
          "receiver": "A6",
          "amount": 1
        }
      ],
      "expect": {
        "outcome": "reject",
        "kind": "forbidden",
        "message": "policy engine rejected request: txn 1: [transfer_policy:route_miss] transfer routing found no route for pay movement; txn 2: [transaction_type:axfer] axfer transactions are rejected by policy; txn 2: [transfer_policy:route_miss] transfer routing found no route for axfer movement; txn 3: [transfer_policy:route_miss] transfer routing found no route for pay movement"
      }
    },
    {
      "name": "passthrough and foreign slots are not judged by policy",
      "surface": "sign",
      "policies": {
        "default": {
          "transfer_policy": {
            "routes": [
              {
                "id": "a1-a2",
                "networks": [
                  "testnet"
                ],
                "sources": [
                  "$A1"
                ],
                "assets": [
                  "algo"
                ],
                "destinations": [
                  "$A2"
                ]
              }
            ]
          }
        }
      },
      "group": [
        {
          "type": "pay",
          "sender": "A1",
          "receiver": "A2",
          "amount": 1
        },
        {
          "type": "pay",
          "sender": "A3",
          "receiver": "A4",
          "amount": 1
        },
        {
          "type": "pay",
          "sender": "A5",
          "receiver": "A6",
          "amount": 1
        }
      ],
      "classes": {
        "1": "passthrough",
        "2": "foreign"
      },
      "expect": {
        "outcome": "default"
      }
    },
