{
  "format": "aplane.policy-verdicts.v1",
  "description": "Always Approve on /sign: the self no-op rule, each plan check it makes, and what outranks it. Cases start from the shipped signer default with auto_approve_self_noop_transfer on.",
  "cases": [
    {
      "name": "self payment",
      "surface": "sign",
      "base": "shipped",
      "policies": {
        "default": {
          "auto_approve_self_noop_transfer": true
        }
      },
      "group": [
        {
          "type": "pay",
          "sender": "A1",
          "receiver": "A1"
        }
      ],
      "expect": {
        "outcome": "approve",
        "rule_id": "auto_approve_self_noop_transfer"
      }
    },
    {
      "name": "asset opt-in",
      "surface": "sign",
      "base": "shipped",
      "policies": {
        "default": {
          "auto_approve_self_noop_transfer": true
        }
      },
      "group": [
        {
          "type": "axfer",
          "sender": "A1",
          "asset": 7,
          "asset_receiver": "A1"
        }
      ],
      "expect": {
        "outcome": "approve",
        "rule_id": "auto_approve_self_noop_transfer"
      }
    },
    {
      "name": "flag off",
      "surface": "sign",
      "base": "shipped",
      "policies": {
        "default": {
          "auto_approve_self_noop_transfer": false
        }
      },
      "group": [
        {
          "type": "pay",
          "sender": "A1",
          "receiver": "A1"
        }
      ],
      "expect": {
        "outcome": "default"
      }
    },
    {
      "name": "strict route table rejects it first",
      "surface": "sign",
      "policies": {
        "default": {
          "auto_approve_self_noop_transfer": true
        }
      },
      "group": [
        {
          "type": "pay",
          "sender": "A1",
          "receiver": "A1"
        }
      ],
      "expect": {
        "outcome": "reject",
        "kind": "forbidden",
        "message": "policy engine rejected request: txn 1: [transfer_policy:route_miss] transfer routing found no route for pay movement"
      }
    },
    {
      "name": "a review rule outranks it",
      "surface": "sign",
      "base": "shipped",
      "policies": {
        "default": {
          "auto_approve_self_noop_transfer": true,
