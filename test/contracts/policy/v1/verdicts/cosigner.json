    {
      "name": "no policy allows a nonparticipating keyreg",
      "surface": "cosigner",
      "policies": {
        "W1": {
          "transaction_types": {
            "*": "allow"
          }
        }
      },
      "group": [
        {
          "type": "keyreg",
