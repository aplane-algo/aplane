      "component_key": "W1",
      "expect": {
        "outcome": "reject",
        "kind": "forbidden",
        "message": "cosigner policy rejected request: txn 1: [cosigner_policy:reject_rekey] rekey transactions must be self-payments"
      }
    },
    {
      "name": "an allowed non-transfer type needs no route",
      "surface": "cosigner",
      "policies": {
        "W1": {
          "transaction_types": {
            "appl": "allow"
          }
        }
      },
      "group": [
        {
          "type": "appl",
          "sender": "A1",
          "app_id": 7
        }
      ],
      "targets": [
        0
      ],
      "component_key": "W1",
      "expect": {
        "outcome": "approve"
      }
    },
    {
      "name": "a wildcard allow covers every type",
      "surface": "cosigner",
      "policies": {
        "W1": {
          "transaction_types": {
            "*": "allow"
          }
        }
      },
      "group": [
        {
          "type": "keyreg",
          "sender": "A1"
        }
      ],
      "targets": [
        0
      ],
      "component_key": "W1",
      "expect": {
        "outcome": "approve"
