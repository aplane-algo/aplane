      "component_key": "W1",
      "expect": {
        "outcome": "reject",
        "kind": "forbidden",
        "message": "cosigner policy rejected request: txn 1: [cosigner_policy:reject_rekey] rekey from AEAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAKE3PRHE to BEAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAOZFNMZM is not allowed by cosigner rekey_policy"
      }
    },
    {
      "name": "a rekey that is not a self-payment",
      "surface": "cosigner",
      "policies": {
        "W1": {
          "rekey_policy": {
            "allowed": [
              {
                "sender": "$A1",
                "targets": [
                  "$A8"
