      "component_key": "W1",
      "expect": {
        "outcome": "error",
        "kind": "forbidden",
        "message": "transaction 1: a keyreg with nonparticipation is not supported: it permanently marks the account as unable to participate"
      }
    },
    {
      "name": "a type the wildcard allows is still rejected by name",
      "surface": "cosigner",
      "policies": {
