{
  "format": "aplane.policy-external-judge.v1",
  "description": "With echo_pointer, the answer must hold the lookup's request ID as a string at that pointer, before any rule is judged. A check without echo_pointer ignores the echo.",
  "cases": [
    {"name": "the echo matches",
     "echo_pointer": "/request_id", "request_id": "0123456789abcdef0123456789abcdef",
     "require": [{"pointer": "/ok", "op": "eq", "bool": true}],
     "answer": {"request_id": "0123456789abcdef0123456789abcdef", "ok": true}, "expect": {"result": "pass"}},
    {"name": "another ID",
     "echo_pointer": "/request_id", "request_id": "0123456789abcdef0123456789abcdef",
     "require": [{"pointer": "/ok", "op": "eq", "bool": true}],
     "answer": {"request_id": "fedcba9876543210fedcba9876543210", "ok": true}, "expect": {"result": "fail", "detail": "echo mismatch: /request_id is not the request ID that was sent"}},
    {"name": "the ID in another case",
     "echo_pointer": "/request_id", "request_id": "0123456789abcdef0123456789abcdef",
     "require": [{"pointer": "/ok", "op": "eq", "bool": true}],
     "answer": {"request_id": "0123456789ABCDEF0123456789ABCDEF", "ok": true}, "expect": {"result": "fail", "detail": "echo mismatch"}},
    {"name": "the echo is a number",
     "echo_pointer": "/request_id", "request_id": "1234",
     "require": [{"pointer": "/ok", "op": "eq", "bool": true}],
     "answer": {"request_id": 1234, "ok": true}, "expect": {"result": "fail", "detail": "echo mismatch"}},
    {"name": "the echo is null",
     "echo_pointer": "/request_id", "request_id": "0123456789abcdef0123456789abcdef",
     "require": [{"pointer": "/ok", "op": "eq", "bool": true}],
     "answer": {"request_id": null, "ok": true}, "expect": {"result": "fail", "detail": "echo mismatch"}},
    {"name": "the echo is missing",
     "echo_pointer": "/request_id", "request_id": "0123456789abcdef0123456789abcdef",
     "require": [{"pointer": "/ok", "op": "eq", "bool": true}],
     "answer": {"ok": true}, "expect": {"result": "fail", "detail": "echo mismatch"}},
    {"name": "a nested echo",
     "echo_pointer": "/meta/id", "request_id": "0123456789abcdef0123456789abcdef",
     "require": [{"pointer": "/ok", "op": "eq", "bool": true}],
     "answer": {"meta": {"id": "0123456789abcdef0123456789abcdef"}, "ok": true}, "expect": {"result": "pass"}},
    {"name": "the echo matches and a rule fails",
     "echo_pointer": "/request_id", "request_id": "0123456789abcdef0123456789abcdef",
     "require": [{"pointer": "/ok", "op": "eq", "bool": true}],
     "answer": {"request_id": "0123456789abcdef0123456789abcdef", "ok": false}, "expect": {"result": "fail", "detail": "/ok = false, want eq true"}},
    {"name": "the echo is judged before the rules",
     "echo_pointer": "/request_id", "request_id": "0123456789abcdef0123456789abcdef",
     "require": [{"pointer": "/ok", "op": "eq", "bool": true}],
     "answer": {"request_id": "other", "ok": false}, "expect": {"result": "fail", "detail": "echo mismatch"}},
    {"name": "without echo_pointer the echo is not judged",
     "request_id": "0123456789abcdef0123456789abcdef",
     "require": [{"pointer": "/ok", "op": "eq", "bool": true}],
     "answer": {"request_id": "fedcba9876543210fedcba9876543210", "ok": true}, "expect": {"result": "pass"}},
    {"name": "without echo_pointer a missing echo is not judged",
     "request_id": "0123456789abcdef0123456789abcdef",
     "require": [{"pointer": "/ok", "op": "eq", "bool": true}],
     "answer": {"ok": true}, "expect": {"result": "pass"}}
  ]
}
