{
  "format": "aplane.policy-external-judge.v1",
  "description": "RFC 6901 pointers: an array is indexed only by 0 or a number without sign or leading zeros, and ~1 and ~0 stand for / and ~ in a member name.",
  "cases": [
    {"name": "index 0",
     "require": [{"pointer": "/list/0", "op": "eq", "number": "10"}],
     "answer": {"list": [10, 20, 30]}, "expect": {"result": "pass"}},
    {"name": "index 1",
     "require": [{"pointer": "/list/1", "op": "eq", "number": "20"}],
     "answer": {"list": [10, 20, 30]}, "expect": {"result": "pass"}},
    {"name": "an index past the end names nothing",
     "require": [{"pointer": "/list/3", "op": "present"}],
     "answer": {"list": [10, 20, 30]}, "expect": {"result": "fail", "detail": "/list/3 missing"}},
    {"name": "a leading zero names nothing",
     "require": [{"pointer": "/list/01", "op": "present"}],
     "answer": {"list": [10, 20, 30]}, "expect": {"result": "fail", "detail": "/list/01 missing"}},
    {"name": "a leading zero is absent",
     "require": [{"pointer": "/list/01", "op": "absent"}],
     "answer": {"list": [10, 20, 30]}, "expect": {"result": "pass"}},
    {"name": "00 names nothing",
     "require": [{"pointer": "/list/00", "op": "present"}],
     "answer": {"list": [10, 20, 30]}, "expect": {"result": "fail", "detail": "/list/00 missing"}},
    {"name": "a plus sign names nothing",
     "require": [{"pointer": "/list/+0", "op": "present"}],
     "answer": {"list": [10, 20, 30]}, "expect": {"result": "fail", "detail": "/list/+0 missing"}},
    {"name": "a minus sign names nothing",
     "require": [{"pointer": "/list/-1", "op": "present"}],
     "answer": {"list": [10, 20, 30]}, "expect": {"result": "fail", "detail": "/list/-1 missing"}},
    {"name": "the past-the-end token names nothing",
     "require": [{"pointer": "/list/-", "op": "present"}],
     "answer": {"list": [10, 20, 30]}, "expect": {"result": "fail", "detail": "/list/- missing"}},
    {"name": "the past-the-end token is absent",
     "require": [{"pointer": "/list/-", "op": "absent"}],
     "answer": {"list": [10, 20, 30]}, "expect": {"result": "pass"}},
    {"name": "a space before the index names nothing",
     "require": [{"pointer": "/list/ 1", "op": "present"}],
     "answer": {"list": [10, 20, 30]}, "expect": {"result": "fail", "detail": "/list/ 1 missing"}},
    {"name": "a decimal index names nothing",
     "require": [{"pointer": "/list/1.0", "op": "present"}],
     "answer": {"list": [10, 20, 30]}, "expect": {"result": "fail", "detail": "/list/1.0 missing"}},
    {"name": "an empty token names nothing in an array",
     "require": [{"pointer": "/list/", "op": "present"}],
     "answer": {"list": [10, 20, 30]}, "expect": {"result": "fail", "detail": "/list/ missing"}},
    {"name": "01 is a member name in an object",
     "require": [{"pointer": "/m/01", "op": "eq", "bool": true}],
     "answer": {"m": {"01": true}}, "expect": {"result": "pass"}},
    {"name": "an empty token is the empty member name",
     "require": [{"pointer": "/", "op": "eq", "number": "5"}],
     "answer": {"": 5}, "expect": {"result": "pass"}},
    {"name": "~1 is a slash in a name",
     "require": [{"pointer": "/a~1b", "op": "eq", "number": "1"}],
     "answer": {"a/b": 1}, "expect": {"result": "pass"}},
    {"name": "an unescaped slash is two tokens",
     "require": [{"pointer": "/a/b", "op": "present"}],
     "answer": {"a/b": 1}, "expect": {"result": "fail", "detail": "/a/b missing"}},
    {"name": "~0 is a tilde in a name",
     "require": [{"pointer": "/m~0n", "op": "eq", "number": "1"}],
     "answer": {"m~n": 1}, "expect": {"result": "pass"}},
    {"name": "~01 is the name ~1, not a slash",
     "require": [{"pointer": "/~01", "op": "eq", "bool": true}],
     "answer": {"~1": true, "/": false}, "expect": {"result": "pass"}},
    {"name": "~1 alone is the name /",
     "require": [{"pointer": "/~1", "op": "eq", "bool": true}],
     "answer": {"/": true, "~1": false}, "expect": {"result": "pass"}},
    {"name": "a name with both a slash and a tilde",
     "require": [{"pointer": "/a~1b~0c", "op": "eq", "string": "both"}],
     "answer": {"a/b~c": "both"}, "expect": {"result": "pass"}},
    {"name": "a refusal names the pointer as written",
     "require": [{"pointer": "/a~1b", "op": "eq", "number": "1"}],
     "answer": {"a/b": 2}, "expect": {"result": "fail", "detail": "/a~1b = 2, want eq 1"}},
    {"name": "a nested object and array",
     "require": [{"pointer": "/risk/scores/1/v", "op": "le", "number": "7"}],
     "answer": {"risk": {"scores": [{"v": 3}, {"v": 7}]}}, "expect": {"result": "pass"}},
    {"name": "a nested value of the wrong type",
     "require": [{"pointer": "/risk/scores/0", "op": "le", "number": "7"}],
     "answer": {"risk": {"scores": [{"v": 3}]}}, "expect": {"result": "fail", "detail": "/risk/scores/0 is an object, want a number"}}
  ]
}
