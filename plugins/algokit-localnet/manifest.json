{
  "name": "algokit-localnet",
  "version": "0.1.0",
  "description": "AlgoKit LocalNet operations for status, KMD account listing, and local funding",
  "author": "APlane Shell Team",
  "homepage": "https://github.com/aplane-algo/aplane",
  "executable": "./algokit-localnet",
  "args": [],
  "commands": [
    {
      "name": "localnet",
      "description": "Inspect and fund a local AlgoKit LocalNet",
      "usage": "localnet status | genesis | accounts | fund <address|alias> [amount] [algo|microalgo] [from <address|alias>]",
      "examples": [
        "localnet status",
        "localnet genesis",
        "localnet accounts",
        "localnet fund alice 100 algo",
        "localnet fund alice 2500000 microalgo from LPB4KVPDCWWU6RHQARBAVVFCZRQKV7BXTKDGRZAPRS7STX6DQMPQKMWALQ"
      ],
      "category": "development",
      "arg_specs": [
        {
          "type": "keyword",
          "values": ["status", "genesis", "accounts", "fund"]
        },
        {
          "branches": [
            {
              "when": {"arg": 0, "matches": "^fund$"},
              "specs": [
                {"type": "address"},
                {"type": "custom", "values": ["amount"]},
                {"type": "keyword", "values": ["algo", "algos", "microalgo", "microalgos", "ualgo", "ualgos"]},
                {"type": "keyword", "values": ["from"]},
                {"type": "address"}
              ]
            }
          ]
        }
      ]
    }
  ],
  "networks": ["localnet"],
  "timeout": 60,
  "manifest_format": "2.0"
}
